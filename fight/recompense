package fight

import (
	"fmt"

	"piscine/player"
)

func RecompenseGoblin1(p *player.Player) {
	if p == nil {
		return
	}

	p.GainXP(150)
	p.Inventory.AddItem("Goblin Teeth")
	p.Inventory.AddItem("Goblin Teeth")
	p.Inventory.AddItem("Iron")

	fmt.Println("Récompense Goblin 1 : +150 XP, 2 dents de goblin et du fer")
}

